{
  "name": "crosshair-y",
  "productName": "Crosshair Y",
  "version": "5.0.0",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.json && vite build",
    "start": "npm run build && node scripts/start.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json",
    "package": "npm run build && node scripts/package.mjs",
    "package:win32": "npm run build && node scripts/package.mjs win32 x64",
    "package:linux": "npm run build && node scripts/package.mjs linux x64",
    "community:index": "node scripts/build-community-index.mjs"
  },
  "keywords": [],
  "author": "YSSF",
  "license": "MIT",
  "description": "Free and open-source crosshair overlay for games",
  "dependencies": {
    "koffi": "^2.9.2",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.2.5",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.11"
  }
}
